{
  "name": "novel-net-test",
  "appid": "8001792304816621",
  "appName": "书海阅读",
  "icon": "app_icon.png",
  "version": "1.1.85",
  "description": "书海阁在线阅读器：搜索/目录跳转/预取/缓存/整本下载",
  "quickjs": {
    "version": "20200705",
    "bigNum": false
  },
  "single-js-bundle": false,
  "scripts": {
    "start": "aiot-cli preview",
    "build": "aiot-cli -p",
    "build:prod": "aiot-cli -c -q -p",
    "bump": "node -e \"const f='package.json',fs=require('fs');const d=JSON.parse(fs.readFileSync(f,'utf8'));const v=d.version.split('.').map(Number);v[2]++;d.version=v.join('.');fs.writeFileSync(f,JSON.stringify(d,null,2)+'\\n');console.log('version ->',d.version)\""
  },
  "keywords": [
    "iot",
    "miniapp"
  ],
  "dependencies": {
    "falcon-ui": "^2.0.2"
  }
}
